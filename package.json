{
    "name": "vue3-helper",
    "displayName": "vue3-helper",
    "description": "一款能大幅提升Vue开发效率的插件。",
    "version": "0.0.2",
    "publisher": "Silin7",
    "icon": "images/icon.png",
    "keywords": [
        "vue3",
        "helper",
        "Silin7"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Silin7/vue3-helper"
    },
    "bugs": {
        "url": "https://github.com/Silin7/vue3-helper/issues",
        "email": "silin7@foxmail.com"
    },
    "homepage": "https://github.com/Silin7/vue3-helper/blob/master/README.md",
    "license": "MIT",
    "engines": {
        "vscode": "^1.63.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./src/extension",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "vue3-helper",
            "properties": {
                "vscodePluginDemo.showTip": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否在每次启动时显示自定义主页"
                }
            }
        },
        "commands": [{
                "command": "extension.showWelcome",
                "title": "休息一下"
            },
            {
                "command": "extension.showTanchi",
                "title": "小游戏-贪吃蛇"
            },
            {
                "command": "extension.showZhuoqiu",
                "title": "小游戏-2D桌球"
            },
            {
                "command": "extension.getCurrentFilePath",
                "title": "获取当前文件(夹)路径"
            },
            {
                "command": "extension.beautyWelfare",
                "title": "随机美女福利图"
            },
            {
                "command": "extension.randomJoke",
                "title": "随机笑话"
            }
        ],
        "menus": {
            "editor/context": [{
                    "when": "editorFocus",
                    "command": "extension.showWelcome",
                    "group": "navigation@3"
                },
                {
                    "when": "editorFocus",
                    "command": "extension.showTanchi",
                    "group": "navigation@4"
                },
                {
                    "when": "editorFocus",
                    "command": "extension.showZhuoqiu",
                    "group": "navigation@5"
                },
                {
                    "when": "editorFocus",
                    "command": "extension.getCurrentFilePath",
                    "group": "navigation@6"
                },
                {
                    "when": "editorFocus",
                    "command": "extension.beautyWelfare",
                    "group": "navigation@7"
                },
                {
                    "when": "editorFocus",
                    "command": "extension.randomJoke",
                    "group": "navigation@8"
                }
            ],

            "explorer/context": [{
                "command": "extension.getCurrentFilePath",
                "group": "navigation"
            }]
        },
        "snippets": [{
                "language": "css",
                "path": "./snippets/css.json"
            },
            {
                "language": "vue",
                "path": "./snippets/vue.json"
            },
            {
                "language": "html",
                "path": "./snippets/vue-template.json"
            },
            {
                "language": "javascript",
                "path": "./snippets/vue-script.json"
            },
            {
                "language": "typescript",
                "path": "./snippets/vue-script.json"
            },
            {
                "language": "javascript",
                "path": "./snippets/vue-router.json"
            },
            {
                "language": "typescript",
                "path": "./snippets/vue-router.json"
            }
        ]
    },
    "devDependencies": {
        "typescript": "^2.6.1",
        "vscode": "^1.63.0",
        "eslint": "^4.11.0",
        "@types/node": "^7.0.43",
        "@types/mocha": "^2.2.42"
    }
}